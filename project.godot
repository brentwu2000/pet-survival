[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="PetFriendly"
3d_physics/layer_4="Enemy"
3d_physics/layer_5="Building"
3d_physics/layer_6="Interactable"
3d_physics/layer_7="Hurtbox"
3d_physics/layer_8="Hitbox"
3d_physics/layer_9="Selectable"
3d_physics/layer_10="BuildBlocker"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
